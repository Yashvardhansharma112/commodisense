# ── Required ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here          # groq.com — free tier, used for AI reports

# ── Optional (enable for higher accuracy) ──────────────────────────────────────
# EIA energy inventory (crude oil + natural gas storage)
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_key_here

# USDA crop progress + stocks data (corn, wheat, soybeans, cotton)
# Free key: https://quickstats.nass.usda.gov/api
USDA_API_KEY=your_usda_key_here

# COT and FRED require NO API key — collected automatically.
